# Copy to .env; fill in the real key LOCALLY. Never commit .env.
TRENDZ_DATA_MODE=real
# TRENDZ_DB_PATH=C:/path/to/approved/trendz.sqlite3
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Enable only on your local machine after verifying the approved measured dataset.
TRENDZ_ASSISTANT_ENABLED=false
